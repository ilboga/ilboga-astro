---
// The "work row" from the ilboga-front CV: title and label on the left,
// a dashed leader line (lg and up), meta on the right.
interface Props {
	title: string;
	href?: string;
	label?: string;
	meta?: string;
}

const { title, href, label, meta } = Astro.props;
---

<li class="flex justify-between items-end">
	<div class="flex flex-col lg:flex-row gap-x-2">
		{href ? <a href={href}>{title}</a> : <span>{title}</span>}
		{label && <span class="text-muted">{label}</span>}
	</div>
	{
		meta && (
			<>
				<div class="hidden lg:flex grow border-t border-dashed border-muted h-1 mx-2 mb-1" />
				<div class="text-muted shrink-0">{meta}</div>
			</>
		)
	}
</li>
