---
import Layout from '../layouts/Layout.astro';
import EntryList from '../components/EntryList.astro';
import { getProjects, isArchived } from '../lib/garden';

const archived = (await getProjects()).filter(isArchived);
---

<Layout title="Archive · ilboga">
	<h1 class="flex flex-col gap-y-3">
		<span>Archive</span>
		<small>Projects that are done or dropped</small>
	</h1>

	<EntryList entries={archived} empty="Nothing archived yet." />
</Layout>
