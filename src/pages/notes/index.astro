---
import Layout from '../../layouts/Layout.astro';
import EntryList from '../../components/EntryList.astro';
import { getNotes } from '../../lib/garden';

const notes = await getNotes();
---

<Layout title="Notes · ilboga">
	<h1 class="flex flex-col gap-y-3">
		<span>Notes</span>
		<small>From seed to evergreen</small>
	</h1>

	<EntryList entries={notes} empty="No notes yet." />
</Layout>
